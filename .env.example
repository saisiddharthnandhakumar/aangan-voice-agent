# Aangan voice agent: every environment variable (PRD section 5 plus agreed extras).
# Copy to .env.local for local work. Never commit real values. Add the same names in Vercel.
# Integration keys may stay empty until you have them: that integration is skipped, not broken.

# --- Neon (written by the build; dev branch locally, main branch on Vercel) ---
DATABASE_URL=            # pooled URL (host contains -pooler)
DATABASE_URL_UNPOOLED=   # direct URL, used by migrations

# --- Gemini (Google AI Studio -> API keys) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash          # GA model, see docs/PLATFORM_NOTES.md section 5
GEMINI_PRICE_IN_PER_MTOK_INR=          # USD price per 1M input tokens x your INR rate
GEMINI_PRICE_OUT_PER_MTOK_INR=         # output, includes thinking tokens

# --- Vaani (app.vaanivoice.ai) ---
VAANI_API_KEY=                         # Settings -> API keys; used for call history and details
VAANI_WEBHOOK_SECRET=                  # you generate (openssl rand -hex 32); goes in the webhook URL token
VAANI_TOOL_SECRET=                     # you generate; Vaani sends it as X-Tool-Secret on tool calls
VAANI_COST_PER_MIN_INR=                # Vaani cost per call = duration x this (call history reports credits, not INR)
VAANI_TEST_AGENT_IDS=                  # comma list of agent IDs whose calls are is_test

# --- Cal.com (Settings -> Security -> API keys) ---
CAL_API_KEY=
CAL_EVENT_TYPE_ID_SITE_VISIT=          # unused since 2026-10-10: only the design call is booked
CAL_EVENT_TYPE_ID_CALL=                # "Aangan design call", booked for Green and Amber
CAL_API_VERSION_SLOTS=2024-09-04
CAL_API_VERSION_BOOKINGS=2026-02-25
CAL_API_BASE_URL=https://api.cal.com   # only change for the local mock (pnpm mock:cal → http://localhost:4010)

# --- HubSpot (legacy private app or service key; IDs printed by pnpm hubspot:setup) ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=                     # for record links
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_BOOKED=
HUBSPOT_STAGE_AWAITING=

# --- Telegram (@BotFather -> /newbot; chat IDs via getUpdates) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                      # designers' group, negative number
TELEGRAM_ESCALATION_CHAT_ID=           # founder chat

# --- App (required in production) ---
APP_BASE_URL=                          # e.g. https://aangan-voice-agent.vercel.app
SESSION_SECRET=                        # openssl rand -hex 32
DASHBOARD_DESIGNER_PASSWORD=
DASHBOARD_FOUNDER_PASSWORD=
CRON_SECRET=                           # openssl rand -hex 32; Vercel cron sends it as a Bearer token

# --- Config ---
STUDIO_PHONE_NUMBER=                   # the office number in +91 format, once linked
ASSUMED_DEAL_VALUE_INR=1100000
BUSINESS_HOURS_START=10:00             # IST
BUSINESS_HOURS_END=19:00               # IST
BUSINESS_DAYS=mon,tue,wed,thu,fri,sat
PLACEHOLDER_EMAIL_DOMAIN=example.com   # bookings need an email; callers without one get <ref>@this-domain
TOOL_RATE_LIMIT_PER_MIN=120            # per client IP, per server instance (T4)
AMBER_STALE_HOURS=4                    # "waiting too long" on the founder view
RETENTION_DAYS=90                      # transcripts and recordings

# --- Internal pricing (never commit real figures; the repo is public) ---
# JSON with the pricing.md floors, estimate midpoints and figures for the leak check.
# Generate it from the local pricing.md with: pnpm pricing:config   (writes it into .env.local)
PRICING_CONFIG_JSON=

# rubric.txt base64-encoded, for the post-call Gemini step (rubric.txt itself is gitignored).
# Generate with: pnpm rubric:build && pnpm rubric:env   (writes it into .env.local)
RUBRIC_TXT_B64=
